{
  "manifest_version": 3,
  "name": "Reload on Browser Restart",
  "description": "ブラウザ再起動時に5秒待って全タブを自動リロードします",
  "version": "1.0.1",
  "permissions": [
    "tabs",
    "storage",
    "alarms"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
